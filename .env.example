# --- Option A: Gemini API (AI Studio key, free tier works) ---
GOOGLE_API_KEY=your-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Option B: Vertex AI (uses Application Default Credentials) ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=asia-south1

AGENT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDER=gemini            # or "hashing" for fully offline demos
WORKSPACE_BACKEND=demo     # or "google" for the Google Calendar connector
REDACT_PII=true
BLOCK_PROMPT_INJECTION=true
# SESSION_DB_URL=postgresql+psycopg://user:pass@/agenthub?host=/cloudsql/PROJECT:REGION:INSTANCE
